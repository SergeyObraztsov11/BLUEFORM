POSTGRES_PASSWORD=replace-with-local-postgres-password
S3_ACCESS_KEY_ID=blueform-local
S3_SECRET_ACCESS_KEY=replace-with-local-s3-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=BLUEFORM <noreply@blueform.local>
# Optional local seed password for buyer@ / ivan@ / admin@blueform.local (min 8 chars)
SEED_PASSWORD=Blueform123!
# Comma-separated emails for new-order alerts (defaults to admin users / admin@blueform.local)
OWNER_NOTIFY_EMAIL=admin@blueform.local
