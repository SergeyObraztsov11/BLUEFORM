{
  "name": "blueform-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/server.ts",
    "build": "npm run db:generate && tsc",
    "start": "node dist/api/src/server.js",
    "check": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate --schema ../prisma/schema.prisma --generator apiClient",
    "test:contract": "node --test tests/contracts.test.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/express-api-reference": "^0.10.34",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/har-format": "^1.2.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
