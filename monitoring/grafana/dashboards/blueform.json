{
  "uid": "blueform-operations",
  "title": "BLUEFORM — состояние сервисов",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Доступность сервисов",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_success{job=\"http-probes\"}",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Время ответа проверки",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"http-probes\"}",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "HTTP-ответы по группам статусов",
      "description": "Суммарное приблизительное количество ответов магазина и API за выбранный период. Значения рассчитываются Prometheus по накопленным счётчикам.",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "round(sum(increase(blueform_http_request_duration_seconds_count{status=~\"2..\"}[$__range])) or vector(0))",
          "refId": "A",
          "legendFormat": "2xx",
          "instant": true
        },
        {
          "expr": "round(sum(increase(blueform_http_request_duration_seconds_count{status=~\"4..\"}[$__range])) or vector(0))",
          "refId": "B",
          "legendFormat": "4xx",
          "instant": true
        },
        {
          "expr": "round(sum(increase(blueform_http_request_duration_seconds_count{status=~\"5..\"}[$__range])) or vector(0))",
          "refId": "C",
          "legendFormat": "5xx",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.65,
        "groupWidth": 0.7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP запросы в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance, status) (rate(blueform_http_request_duration_seconds_count[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP ошибки 5xx в секунду",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(blueform_http_request_duration_seconds_count{status=~\"5..\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Время ответа HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, instance) (rate(blueform_http_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Подключения PostgreSQL",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(pg_stat_activity_count) by (datname)",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "CPU группы контейнеров Docker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{id=\"/docker\"}[5m]) * 100",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Память группы контейнеров Docker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{id=\"/docker\"}",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Журналы приложения",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "{service_name=~\"web|api\"}",
          "refId": "A",
          "legendFormat": "{{instance}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "CPU среды Docker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Память среды Docker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Диск среды Docker",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 40,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(node_filesystem_size_bytes{mountpoint=~\"/|/mnt/docker-desktop-disk\",fstype!=\"rootfs\"} - node_filesystem_avail_bytes{mountpoint=~\"/|/mnt/docker-desktop-disk\",fstype!=\"rootfs\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Ошибки оформления заказа",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(blueform_order_attempts_total{status=~\"5..\"}[1h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Ошибки отправки писем",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(blueform_mail_attempts_total{outcome=\"error\"}[1h])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}
